# Trafft API connection
# Copy this file to .env and fill in your real values.
# Find these in Trafft under Features & Integrations > API > Set Up.
# The .env file is gitignored and must never be committed.

# Full base URL of your Trafft instance (no trailing slash).
#   Cloud account:  https://yoursubdomain.trafft.com
#   Self-hosted:    https://booking.yourdomain.com
TRAFFT_API_URL=https://yoursubdomain.trafft.com

# Client credentials from the API setup page.
TRAFFT_CLIENT_ID=your_client_id_here
TRAFFT_CLIENT_SECRET=your_client_secret_here

# Optional. API version path appended to the base URL.
# Defaults to /api/v2 when left unset. Only change this if your
# Trafft instance documents a different version path.
# TRAFFT_API_PATH=/api/v2
